# ==========================================
# The Lenny Growth Assistant - Environment Config
# ==========================================

# Server Environment
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Persistence
# For local evaluation without Docker, uses SQLite automatically:
DATABASE_URL=sqlite+aiosqlite:///lenny_assistant.db
# For production PostgreSQL / Railway / Supabase:
# DATABASE_URL=postgresql+asyncpg://lenny_user:lenny_secret_password@localhost:5432/lenny_assistant_db

# Primary Model Provider ('ollama' | 'anthropic' | 'openai')
# Mandatory for the demo: 'ollama'
DEFAULT_LLM_PROVIDER=ollama

# Ollama Local Configuration (Mandatory for demo evaluation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Cloud LLM Configuration (Optional / Evaluation Switch)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Retrieval Hyperparameters
RETRIEVAL_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80
